pkgname=kyvyrn
pkgver=0.1.0
pkgrel=1
pkgdesc="Native desktop app built with Tauri"
arch=("x86_64")
url="https://your.repo"
license=("MIT")

depends=(
  "webkit2gtk-4.1"
  "gtk3"
)

package() {
  # binary
  install -Dm755 \
    "$srcdir/../src-tauri/target/release/kyvyrn" \
    "$pkgdir/usr/bin/kyvyrn"

  # desktop file (generated by Tauri)
  install -Dm644 \
    "$srcdir/../src-tauri/target/release/bundle/app/kyvyrn.desktop" \
    "$pkgdir/usr/share/applications/kyvyrn.desktop"

  # icons (generated by Tauri)
  for size in 32x32 128x128 256x256; do
    install -Dm644 \
      "$srcdir/../src-tauri/target/release/bundle/app/icons/$size.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/kyvyrn.png"
  done
}
